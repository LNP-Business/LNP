{
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "skl-os-romain-8012.vercel.app"
        }
      ],
      "destination": "https://skl-os.vercel.app/",
      "permanent": false
    },
    {
      "source": "/:path((?!api/|\\.well-known/).+)",
      "has": [
        {
          "type": "host",
          "value": "skl-os-romain-8012.vercel.app"
        }
      ],
      "destination": "https://skl-os.vercel.app/:path+",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?op=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth?op=resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?op=metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/oauth?op=metadata"
    },
    {
      "source": "/api/oauth/register",
      "destination": "/api/oauth?op=register"
    },
    {
      "source": "/api/oauth/authorize",
      "destination": "/api/oauth?op=authorize"
    },
    {
      "source": "/api/oauth/token",
      "destination": "/api/oauth?op=token"
    }
  ],
  "functions": {
    "api/mcp.js": {
      "maxDuration": 30,
      "includeFiles": "api/_kb.json"
    },
    "api/planner.js": {
      "maxDuration": 60,
      "includeFiles": "api/{_kb,_prompts}.json"
    }
  }
}
